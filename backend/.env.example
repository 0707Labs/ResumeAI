# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Only for API keys not scoped to a workspace: the workspace to bill (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
# Comma-separated origins allowed to call the API (the Next.js dev server by default)
CORS_ORIGINS=http://localhost:3000
# Postgres (psycopg 3). Default: the local socket, database resume_tailor.
# Create and migrate: createdb resume_tailor && .venv/bin/alembic upgrade head
RT_DATABASE_URL=postgresql+psycopg:///resume_tailor
# Long random string; signs short-lived auth cookies. e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
RT_AUTH_SECRET=
# Public origin of the frontend: base for OAuth redirect URIs and the CSRF Origin check
RT_PUBLIC_URL=http://localhost:3000
# Tests: a Postgres server where pytest may create and drop throwaway databases
RT_TEST_ADMIN_DATABASE_URL=postgresql+psycopg:///postgres
# Invite-only mode (default 1). 0 = open signup: new accounts skip the invite step
RT_INVITE_ONLY=1
# Local e2e only: multiply rate limits (ignored unless RT_PUBLIC_URL is localhost). See docs/testing.md.
# RT_DEV_RATE_LIMIT_SCALE=10
# Magic-link delivery: "outbox" writes emails to backend/.dev-outbox/ (dev, tests, e2e);
# "ses" sends through Amazon SES. With "ses" the server won't start without RT_MAIL_FROM and
# the AWS keys, and when RT_PUBLIC_URL isn't localhost it won't start without "ses".
# Setup, IAM policy and SPF/DKIM/DMARC: docs/email.md.
RT_MAILER=outbox
# Sender (its domain verified in SES), e.g. Resume Tailor <no-reply@mail.example.com>
RT_MAIL_FROM=
# SES region (default ap-south-1) and optional configuration set
RT_SES_REGION=ap-south-1
RT_SES_CONFIGURATION_SET=
# Send-only IAM credentials (ses:SendEmail on the sender identity). Session token: temporary creds only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# OAuth apps (Google Cloud project + GitHub org owned by 0707Labs). Leave empty to show
# "Provider unavailable". Register exactly these redirect URIs:
#   {RT_PUBLIC_URL}/api/auth/google/callback   and   {RT_PUBLIC_URL}/api/auth/github/callback
# Scopes requested: Google "openid email profile"; GitHub "read:user user:email".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Dodo Payments (merchant of record). Use test-mode values until go-live; test and live
# have separate keys, webhook secrets and products. Dashboard: Developer -> API Keys / Webhooks.
DODO_API_KEY=
# The endpoint's signing secret (whsec_...)
DODO_WEBHOOK_SECRET=
# test | live. Anything else disables payments.
DODO_ENVIRONMENT=test
# Optional: your Dodo business id, for the customer-portal login link
DODO_BUSINESS_ID=
# Optional: show the Pro subscription (overrides products.pro_monthly.enabled in billing.toml)
RT_BILLING_PRO_ENABLED=

# Optional: Slack incoming webhook for Claude budget alerts (https://hooks.slack.com/...).
RT_SLACK_WEBHOOK_URL=

# Optional: error reporting to Sentry (off when empty). Events never carry request bodies,
# headers, cookies, exception messages or resume/JD text: docs/deploy.md, "Error reporting".
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
