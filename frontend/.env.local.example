# Where the Next.js server proxies /api/* and /health (the FastAPI backend)
RT_BACKEND_URL=http://localhost:8000
# Optional: call a backend directly instead of through the proxy. Leave unset in the
# browser app: sign-in cookies only work same-origin. Node-side tests default to :8000.
# NEXT_PUBLIC_API_URL=http://localhost:8000
# Public pages (landing, /legal/*): canonical site URL, and the grievance officer the
# footer and /legal/grievance name (IT Rules 2021 / DPDP Act). Empty = "to be published".
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
# NEXT_PUBLIC_GRIEVANCE_OFFICER_EMAIL=
